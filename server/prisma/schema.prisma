generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id_user   Int    @id @default(autoincrement())
  email     String @unique
  full_name String
  password  String
  role      Role   @default(EMPLOYEE)

  exitRequests ExitRequest[]
}

model ExitRequest {
  id_request  Int        @id @default(autoincrement())
  reason      String
  employeeId  Int
  requestedAt DateTime   @default(now())
  status      ExitStatus @default(PENDING)

  employee    User       @relation(fields: [employeeId], references: [id_user])
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ExitStatus {
  PENDING
  APPROVED
  REJECTED
}
