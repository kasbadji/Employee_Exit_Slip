generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id_user   Int    @id @default(autoincrement())
  email     String @unique
  full_name String
  password  String
  role      Role[] @default([Employee])
}
enum Role {
  Admin
  Manager
  Employee
}
